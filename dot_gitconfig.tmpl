[user]
    name = Dan Aimone
    email = 30274286+danaimone@users.noreply.github.com
{{- if lookPath "op" }}
    signingkey = {{ onepasswordRead "op://Personal/SSH Key Github/public key" }}
{{- else }}
    # signingkey will be populated after 1Password CLI is set up — re-run: chezmoi apply
{{- end }}

[gpg]
    format = ssh

[gpg "ssh"]
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[commit]
    gpgsign = true

[include]
    path = ~/.config/delta/themes/catppuccin.gitconfig

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    features = catppuccin-mocha

[merge]
    conflictStyle = zdiff3

[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
