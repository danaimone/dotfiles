{{- if eq .chezmoi.os "darwin" -}}
# SSH Configuration for macOS
# Managed by chezmoi - edit via: chezmoi edit ~/.ssh/config

# 1Password SSH Agent integration
Host *
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# GitHub
Host github.com
    HostName github.com
    User git

# Homelab/Proxmox Server
Host homelab proxmox
    HostName {{ onepasswordRead "op://Personal/Proxmox SSH Key/IP" }}
    User {{ onepasswordRead "op://Personal/Proxmox SSH Key/username" }}
    Port {{ onepasswordRead "op://Personal/Proxmox SSH Key/SSH Port" }}
    IdentityFile ~/.ssh/id_proxmox_root.pub
    IdentitiesOnly yes
    ForwardAgent yes

# Homelab as root — key "Homelab Root" lives in 1Password; the .pub just
# tells the 1P agent which key to offer.
Host homelab-root
    HostName {{ onepasswordRead "op://Personal/Proxmox SSH Key/IP" }}
    User root
    Port {{ onepasswordRead "op://Personal/Proxmox SSH Key/SSH Port" }}
    IdentityFile ~/.ssh/id_homelab_root.pub
    IdentitiesOnly yes

# Seedbox
Host seedbox
    HostName {{ onepasswordRead "op://Personal/Ultra key/IP" }}
    User {{ onepasswordRead "op://Personal/Ultra key/username" }}
    Port {{ onepasswordRead "op://Personal/Ultra key/SSH Port" }}

# Ugoos CoreELEC — multiplex aggressively so dropbear only ever sees one
# live connection; repeated `ssh ugoos` invocations reuse it as channels.
Host ugoos
    HostName {{ onepasswordRead "op://Personal/Ugoos CoreElec SSH/IP" }}
    User {{ onepasswordRead "op://Personal/Ugoos CoreElec SSH/username" }}
    Port {{ onepasswordRead "op://Personal/Ugoos CoreElec SSH/SSH Port" }}
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m
    ServerAliveInterval 60

Host mini-dan
  Hostname {{ onepasswordRead "op://Personal/ayuhdycrp5xrxteb57eufve4wq/IP" }}
  User danaimone
  Port {{ onepasswordRead "op://Personal/ayuhdycrp5xrxteb57eufve4wq/port" }}
  ForwardAgent yes

Host mini-claw
  Hostname {{ onepasswordRead "op://Personal/ayuhdycrp5xrxteb57eufve4wq/IP" }}
  User openclaw
  Port {{ onepasswordRead "op://Personal/ayuhdycrp5xrxteb57eufve4wq/port" }}
  ForwardAgent yes

# Hermes agent host (CT 145 on homelab)
Host onyx
  Hostname {{ onepasswordRead "op://Personal/u5koqupo4x756unox4eh656z2q/IP" }}
  User root
  Port {{ onepasswordRead "op://Personal/u5koqupo4x756unox4eh656z2q/port" }}

# Add more hosts as needed below
# Example:
# Host example
#     HostName example.com
#     User your-username
#     Port 22

# 1Password SSH bookmarks — per-host Match blocks that pin each host to
# its bookmarked key. Placed at the end so User/Hostname from the Host
# blocks above are already set when these Match conditions evaluate.
# Reset the preceding Host scope so bookmarks apply to every host.
Match all
Include ~/.ssh/1Password/config

{{ end -}}
