# Ignore cache and temporary files that shouldn't be managed by chezmoi

# Oh My Zsh cache directories
.oh-my-zsh/cache/**
.oh-my-zsh/log/**

# Tmux plugin manager generated files
.tmux/plugins/**/doc/
.tmux/plugins/**/.git/
.config/tmux/plugins/catppuccin/

# Neovim generated files
.local/share/nvim/lazy/
.local/share/nvim/mason/
.local/share/nvim/swap/
.local/share/nvim/shada/
.local/share/nvim/undo/

# SSH known hosts (machine-specific)
.ssh/known_hosts
.ssh/known_hosts.old

# Zsh history (machine-specific)
.history
.zsh_history

# Other cache directories
.cache/

# Non-macOS hosts (e.g. the Proxmox box, root uses bash): only take the
# portable bits — tmux, nvim, starship, bat, delta, lazygit. .gitconfig is
# Mac-only too: it hardwires 1Password op-ssh-sign for commit signing.
{{ if ne .chezmoi.os "darwin" }}
README.md
.gitconfig
.claude
.claude/**
.config/ghostty
.config/ghostty/**
.config/gh
.config/gh/**
.ideavimrc
.ssh
.ssh/**
.zshrc
.oh-my-zsh
.oh-my-zsh/**
{{ end }}
